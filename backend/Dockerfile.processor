FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# These are the processor's locked runtime wheels; source fallback is forbidden.
RUN pip install --no-cache-dir --only-binary=:all: \
    Pillow==13.0.0 pikepdf==10.18.2 lxml==6.1.3 packaging==26.3 \
    && useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin processor

COPY metaguard_api/__init__.py \
    metaguard_api/file_processing.py \
    metaguard_api/processing_limits.py \
    metaguard_api/processing_types.py \
    metaguard_api/processing_worker.py ./metaguard_api/

USER 65532:65532
CMD ["python", "-m", "metaguard_api.processing_worker"]
